# Node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# rs-graph output — contains extracted source structure/signatures, treat as sensitive as the source itself
.rs-graph/
*.db
*.db-journal
*.db-wal
*.db-shm

# .NET
bin/
obj/
*.user

# Python
__pycache__/
.pytest_cache/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# eval harness — machine-local repo paths and raw run output, never for commit
packages/eval/repos.config.json
packages/eval/results/

# test fixtures are re-indexed by the test suite on every run, which (unlike a real target repo,
# where committing these is the point) regenerates these as throwaway artifacts each time —
# occasionally left behind by a vitest worker-teardown race across parallel test files
fixtures/**/.mcp.json
fixtures/**/.githooks/
